# Copy to .env and fill in. .env is never committed.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Product Sheet
# Local builds: path to the service account key file (kept outside the project)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Cloudflare builds: paste the key's JSON content instead (set in Cloudflare, not here)
GOOGLE_SERVICE_ACCOUNT_KEY=
